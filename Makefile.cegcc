# Makefile.cegcc - build Album95 using the cegcc (arm‑mingw32ce) toolchain
# based on the original Makefile in this directory.
#
# Usage: simply run `make -f Makefile.cegcc` from the album95 directory.
# The cross‑compiler must be installed and in PATH (arm-mingw32ce-g++).

CXX      = arm-mingw32ce-g++
# tune optimization/diagnostics for WinCE; match flags used in other WinCE
# makefiles we ship in the workspace.
CXXFLAGS = -D_WIN32_WCE=400 -O2 -g0 -Wall -fno-exceptions -fno-rtti -ffunction-sections -fdata-sections

LIBS     = -L. -lcommctrl -lbass

TARGET   = Album95.exe
OBJS     = wince_compat.o main.o

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(OBJS) -o $(TARGET) \
	  -static-libgcc -static-libstdc++ \
	  -Wl,--stack=0x100000 \
	  $(LIBS)

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $<

clean:
	rm -f *.o $(TARGET)
